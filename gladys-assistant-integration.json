{
  "manifest_version": 1,
  "type": "device",
  "name": "Woodpecker CI",
  "description": {
    "en": "Your Woodpecker CI pipelines in Gladys: status, failure alerts, restart from a scene.",
    "fr": "Vos pipelines Woodpecker CI dans Gladys : état, alertes d'échec, relance depuis une scène.",
    "de": "Deine Woodpecker-CI-Pipelines in Gladys: Status, Fehlerwarnungen, Neustart aus einer Szene.",
    "es": "Sus pipelines de Woodpecker CI en Gladys: estado, alertas de fallo, relanzar desde una escena."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-woodpecker:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-woodpecker/main/cover.png",
  "categories": ["services"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your Woodpecker server",
        "fr": "Votre serveur Woodpecker",
        "de": "Dein Woodpecker-Server",
        "es": "Su servidor Woodpecker"
      },
      "description": {
        "en": "Enter the address of your Woodpecker server and a personal access token (click your avatar at the top right → Personal access token). The pipelines of the repositories this user can see are followed.",
        "fr": "Saisissez l'adresse de votre serveur Woodpecker et un jeton d'accès personnel (cliquez sur votre avatar en haut à droite → Jeton d'accès personnel). Les pipelines des dépôts que cet utilisateur voit sont suivis.",
        "de": "Gib die Adresse deines Woodpecker-Servers und ein persönliches Zugriffstoken ein (klicke oben rechts auf deinen Avatar → Persönliches Zugriffstoken). Die Pipelines der Repositorys, die dieser Benutzer sieht, werden verfolgt.",
        "es": "Introduzca la dirección de su servidor Woodpecker y un token de acceso personal (haga clic en su avatar arriba a la derecha → Token de acceso personal). Se siguen los pipelines de los repositorios que ve este usuario."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-woodpecker/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Einrichtungsanleitung",
            "es": "Guía de instalación"
          }
        },
        {
          "url": "https://woodpecker-ci.org/api",
          "label": {
            "en": "Woodpecker API",
            "fr": "API de Woodpecker",
            "de": "Woodpecker-API",
            "es": "API de Woodpecker"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "Woodpecker address",
        "fr": "Adresse de Woodpecker",
        "de": "Adresse von Woodpecker",
        "es": "Dirección de Woodpecker"
      },
      "description": {
        "en": "The address you open Woodpecker with: http://192.168.1.2:8000 or https://ci.example.com.",
        "fr": "L'adresse avec laquelle vous ouvrez Woodpecker : http://192.168.1.2:8000 ou https://ci.example.com.",
        "de": "Die Adresse, mit der du Woodpecker öffnest: http://192.168.1.2:8000 oder https://ci.example.com.",
        "es": "La dirección con la que abre Woodpecker: http://192.168.1.2:8000 o https://ci.example.com."
      },
      "placeholder": {
        "en": "e.g. http://192.168.1.2:8000",
        "fr": "ex. http://192.168.1.2:8000",
        "de": "z. B. http://192.168.1.2:8000",
        "es": "p. ej. http://192.168.1.2:8000"
      },
      "required": false
    },
    {
      "key": "token",
      "type": "secret",
      "label": {
        "en": "Personal access token",
        "fr": "Jeton d'accès personnel",
        "de": "Persönliches Zugriffstoken",
        "es": "Token de acceso personal"
      },
      "description": {
        "en": "Reads the repositories of its user. An admin's token also gives the queue and the connected agents.",
        "fr": "Lit les dépôts de son utilisateur. Le jeton d'un administrateur donne aussi la file et les agents connectés.",
        "de": "Liest die Repositorys seines Benutzers. Das Token eines Admins liefert auch die Warteschlange und die verbundenen Agenten.",
        "es": "Lee los repositorios de su usuario. El token de un administrador también da la cola y los agentes conectados."
      },
      "required": false
    },
    {
      "key": "repos",
      "type": "string",
      "label": {
        "en": "Repositories to follow",
        "fr": "Dépôts à suivre",
        "de": "Zu verfolgende Repositorys",
        "es": "Repositorios que seguir"
      },
      "description": {
        "en": "Empty: every active repository (50 at most). Otherwise owner/name or links, separated by commas; an owner alone follows all its repositories.",
        "fr": "Vide : tous les dépôts actifs (50 au plus). Sinon propriétaire/nom ou des liens, séparés par des virgules ; un propriétaire seul suit tous ses dépôts.",
        "de": "Leer: alle aktiven Repositorys (höchstens 50). Sonst Besitzer/Name oder Links, durch Kommas getrennt; ein Besitzer allein verfolgt alle seine Repositorys.",
        "es": "Vacío: todos los repositorios activos (50 como máximo). Si no, propietario/nombre o enlaces, separados por comas; un propietario solo sigue todos sus repositorios."
      },
      "placeholder": {
        "en": "e.g. alice/website, my-org",
        "fr": "ex. alice/site, mon-orga",
        "de": "z. B. alice/website, meine-org",
        "es": "p. ej. alice/web, mi-org"
      },
      "required": false
    },
    {
      "key": "options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      }
    },
    {
      "key": "scope",
      "type": "select",
      "label": {
        "en": "Pipelines that count",
        "fr": "Pipelines pris en compte",
        "de": "Berücksichtigte Pipelines",
        "es": "Pipelines que cuentan"
      },
      "description": {
        "en": "Which pipelines give the status of a repository and fire the scene triggers.",
        "fr": "Les pipelines qui donnent l'état d'un dépôt et déclenchent les scènes.",
        "de": "Welche Pipelines den Status eines Repositorys bestimmen und die Szenen auslösen.",
        "es": "Qué pipelines dan el estado de un repositorio y activan las escenas."
      },
      "required": false,
      "default": "default_branch",
      "options": [
        {
          "value": "default_branch",
          "label": {
            "en": "Default branch only (no pull request)",
            "fr": "Branche par défaut seulement (sans pull request)",
            "de": "Nur Standard-Branch (ohne Pull-Request)",
            "es": "Solo la rama predeterminada (sin pull request)"
          }
        },
        {
          "value": "all",
          "label": {
            "en": "All (branches, pull requests, tags)",
            "fr": "Tous (branches, pull requests, tags)",
            "de": "Alle (Branches, Pull-Requests, Tags)",
            "es": "Todos (ramas, pull requests, etiquetas)"
          }
        }
      ]
    },
    {
      "key": "allow_restart",
      "type": "boolean",
      "label": {
        "en": "Allow scenes to restart pipelines",
        "fr": "Autoriser les scènes à relancer des pipelines",
        "de": "Szenen dürfen Pipelines neu starten",
        "es": "Permitir que las escenas relancen pipelines"
      },
      "description": {
        "en": "Off by default. When on, the \"Restart the last Woodpecker pipeline\" action can restart the pipeline of any followed repository: the token's user needs the push permission.",
        "fr": "Désactivé par défaut. Activé, l'action « Relancer le dernier pipeline Woodpecker » peut relancer le pipeline de tout dépôt suivi : l'utilisateur du jeton doit avoir le droit push.",
        "de": "Standardmäßig aus. Wenn an, kann die Aktion „Letzte Woodpecker-Pipeline neu starten“ die Pipeline jedes verfolgten Repositorys neu starten: Der Benutzer des Tokens braucht das Recht push.",
        "es": "Desactivado por defecto. Si se activa, la acción «Relanzar el último pipeline de Woodpecker» puede relanzar el pipeline de cualquier repositorio seguido: el usuario del token necesita el permiso push."
      },
      "required": false,
      "default": false
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle d'actualisation",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often Woodpecker is read: two light requests, plus one per repository whose pipelines moved.",
        "fr": "La fréquence de lecture de Woodpecker : deux requêtes légères, plus une par dépôt dont les pipelines ont bougé.",
        "de": "Wie oft Woodpecker gelesen wird: zwei leichte Anfragen, plus eine pro Repository mit neuen Pipelines.",
        "es": "Con qué frecuencia se lee Woodpecker: dos solicitudes ligeras, más una por repositorio cuyos pipelines han cambiado."
      },
      "required": false,
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "2",
          "label": {
            "en": "2 minutes",
            "fr": "2 minutes",
            "de": "2 Minuten",
            "es": "2 minutos"
          }
        },
        {
          "value": "5",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "10 minutes",
            "fr": "10 minutes",
            "de": "10 Minuten",
            "es": "10 minutos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Language of the feature names (set when a device is added), of the statuses and of the scene texts.",
        "fr": "Langue des noms des fonctionnalités (fixés à l'ajout d'un appareil), des états et des textes de scène.",
        "de": "Sprache der Funktionsnamen (beim Hinzufügen eines Geräts festgelegt), der Status und der Szenentexte.",
        "es": "Idioma de los nombres de las funciones (fijados al añadir un dispositivo), de los estados y de los textos de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "pipeline_finished",
      "label": {
        "en": "Woodpecker pipeline finished",
        "fr": "Pipeline Woodpecker terminé",
        "de": "Woodpecker-Pipeline beendet",
        "es": "Pipeline de Woodpecker terminado"
      },
      "description": {
        "en": "A pipeline of a followed repository ended, whatever its result.",
        "fr": "Un pipeline d'un dépôt suivi s'est terminé, quel que soit son résultat.",
        "de": "Eine Pipeline eines verfolgten Repositorys ist beendet, egal mit welchem Ergebnis.",
        "es": "Ha terminado un pipeline de un repositorio seguido, sea cual sea su resultado."
      },
      "fields": [
        {
          "key": "repo",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Repository",
            "fr": "Dépôt",
            "de": "Repository",
            "es": "Repositorio"
          }
        },
        {
          "key": "result",
          "type": "select",
          "label": {
            "en": "Result",
            "fr": "Résultat",
            "de": "Ergebnis",
            "es": "Resultado"
          },
          "options": [
            {
              "value": "success",
              "label": {
                "en": "Success",
                "fr": "Réussi",
                "de": "Erfolgreich",
                "es": "Correcto"
              }
            },
            {
              "value": "failure",
              "label": {
                "en": "Failed",
                "fr": "En échec",
                "de": "Fehlgeschlagen",
                "es": "Fallido"
              }
            },
            {
              "value": "error",
              "label": {
                "en": "Error",
                "fr": "Erreur",
                "de": "Fehler",
                "es": "Error"
              }
            },
            {
              "value": "killed",
              "label": {
                "en": "Cancelled",
                "fr": "Annulé",
                "de": "Abgebrochen",
                "es": "Cancelado"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "repo_name",
          "type": "string",
          "label": {
            "en": "Repository name",
            "fr": "Nom du dépôt",
            "de": "Name des Repositorys",
            "es": "Nombre del repositorio"
          }
        },
        {
          "key": "number",
          "type": "number",
          "label": {
            "en": "Pipeline number",
            "fr": "Numéro du pipeline",
            "de": "Pipeline-Nummer",
            "es": "Número del pipeline"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "Result, in words",
            "fr": "Résultat, en toutes lettres",
            "de": "Ergebnis in Worten",
            "es": "Resultado, en palabras"
          }
        },
        {
          "key": "branch",
          "type": "string",
          "label": {
            "en": "Branch",
            "fr": "Branche",
            "de": "Branch",
            "es": "Rama"
          }
        },
        {
          "key": "event",
          "type": "string",
          "label": {
            "en": "Event (push, tag, manual…)",
            "fr": "Événement (push, tag, manuel…)",
            "de": "Ereignis (Push, Tag, manuell…)",
            "es": "Evento (push, etiqueta, manual…)"
          }
        },
        {
          "key": "duration",
          "type": "number",
          "label": {
            "en": "Duration (seconds)",
            "fr": "Durée (secondes)",
            "de": "Dauer (Sekunden)",
            "es": "Duración (segundos)"
          }
        },
        {
          "key": "url",
          "type": "string",
          "label": {
            "en": "Link",
            "fr": "Lien",
            "de": "Link",
            "es": "Enlace"
          }
        },
        {
          "key": "summary",
          "type": "string",
          "label": {
            "en": "Summary, ready for a message",
            "fr": "Résumé, prêt pour un message",
            "de": "Zusammenfassung für eine Nachricht",
            "es": "Resumen, listo para un mensaje"
          }
        }
      ]
    },
    {
      "key": "repo_status_changed",
      "label": {
        "en": "Woodpecker repository failing or back to green",
        "fr": "Dépôt Woodpecker en échec ou revenu au vert",
        "de": "Woodpecker-Repository fehlgeschlagen oder wieder grün",
        "es": "Repositorio de Woodpecker fallido o de nuevo en verde"
      },
      "description": {
        "en": "A repository starts failing (failed pipeline or error), or passes again after a failure.",
        "fr": "Un dépôt passe en échec (pipeline en échec ou en erreur), ou réussit de nouveau après un échec.",
        "de": "Ein Repository schlägt fehl (fehlgeschlagene Pipeline oder Fehler) oder ist nach einem Fehler wieder erfolgreich.",
        "es": "Un repositorio empieza a fallar (pipeline fallido o con error), o vuelve a pasar tras un fallo."
      },
      "fields": [
        {
          "key": "repo",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Repository",
            "fr": "Dépôt",
            "de": "Repository",
            "es": "Repositorio"
          }
        },
        {
          "key": "state",
          "type": "select",
          "label": {
            "en": "Change",
            "fr": "Changement",
            "de": "Änderung",
            "es": "Cambio"
          },
          "options": [
            {
              "value": "failure",
              "label": {
                "en": "Failing",
                "fr": "En échec",
                "de": "Fehlgeschlagen",
                "es": "Fallido"
              }
            },
            {
              "value": "success",
              "label": {
                "en": "Back to green",
                "fr": "Revenu au vert",
                "de": "Wieder grün",
                "es": "De nuevo en verde"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "repo_name",
          "type": "string",
          "label": {
            "en": "Repository name",
            "fr": "Nom du dépôt",
            "de": "Name des Repositorys",
            "es": "Nombre del repositorio"
          }
        },
        {
          "key": "number",
          "type": "number",
          "label": {
            "en": "Pipeline number",
            "fr": "Numéro du pipeline",
            "de": "Pipeline-Nummer",
            "es": "Número del pipeline"
          }
        },
        {
          "key": "result",
          "type": "string",
          "label": {
            "en": "Result (success, failure, error)",
            "fr": "Résultat (success, failure, error)",
            "de": "Ergebnis (success, failure, error)",
            "es": "Resultado (success, failure, error)"
          }
        },
        {
          "key": "branch",
          "type": "string",
          "label": {
            "en": "Branch",
            "fr": "Branche",
            "de": "Branch",
            "es": "Rama"
          }
        },
        {
          "key": "url",
          "type": "string",
          "label": {
            "en": "Link",
            "fr": "Lien",
            "de": "Link",
            "es": "Enlace"
          }
        },
        {
          "key": "summary",
          "type": "string",
          "label": {
            "en": "Summary, ready for a message",
            "fr": "Résumé, prêt pour un message",
            "de": "Zusammenfassung für eine Nachricht",
            "es": "Resumen, listo para un mensaje"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "restart_pipeline",
      "label": {
        "en": "Restart the last Woodpecker pipeline",
        "fr": "Relancer le dernier pipeline Woodpecker",
        "de": "Letzte Woodpecker-Pipeline neu starten",
        "es": "Relanzar el último pipeline de Woodpecker"
      },
      "description": {
        "en": "Restart the last pipeline of a followed repository, on the same commit. Needs \"Allow scenes to restart pipelines\".",
        "fr": "Relance le dernier pipeline d'un dépôt suivi, sur le même commit. Exige « Autoriser les scènes à relancer des pipelines ».",
        "de": "Startet die letzte Pipeline eines verfolgten Repositorys auf demselben Commit neu. Erfordert „Szenen dürfen Pipelines neu starten“.",
        "es": "Relanza el último pipeline de un repositorio seguido, sobre el mismo commit. Requiere «Permitir que las escenas relancen pipelines»."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "repo",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Repository",
            "fr": "Dépôt",
            "de": "Repository",
            "es": "Repositorio"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "repo_name",
          "type": "string",
          "label": {
            "en": "Repository name",
            "fr": "Nom du dépôt",
            "de": "Name des Repositorys",
            "es": "Nombre del repositorio"
          }
        },
        {
          "key": "restarted_number",
          "type": "number",
          "label": {
            "en": "Number of the pipeline restarted",
            "fr": "Numéro du pipeline relancé",
            "de": "Nummer der neu gestarteten Pipeline",
            "es": "Número del pipeline relanzado"
          }
        },
        {
          "key": "number",
          "type": "number",
          "label": {
            "en": "Number of the new pipeline",
            "fr": "Numéro du nouveau pipeline",
            "de": "Nummer der neuen Pipeline",
            "es": "Número del nuevo pipeline"
          }
        },
        {
          "key": "url",
          "type": "string",
          "label": {
            "en": "Link",
            "fr": "Lien",
            "de": "Link",
            "es": "Enlace"
          }
        }
      ]
    },
    {
      "key": "get_repo",
      "label": {
        "en": "Read a Woodpecker repository",
        "fr": "Lire un dépôt Woodpecker",
        "de": "Woodpecker-Repository lesen",
        "es": "Leer un repositorio de Woodpecker"
      },
      "description": {
        "en": "The state of a followed repository, for the next actions of the scene.",
        "fr": "L'état d'un dépôt suivi, pour les actions suivantes de la scène.",
        "de": "Der Status eines verfolgten Repositorys für die nächsten Aktionen der Szene.",
        "es": "El estado de un repositorio seguido, para las siguientes acciones de la escena."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "repo",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Repository",
            "fr": "Dépôt",
            "de": "Repository",
            "es": "Repositorio"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "repo_name",
          "type": "string",
          "label": {
            "en": "Repository name",
            "fr": "Nom du dépôt",
            "de": "Name des Repositorys",
            "es": "Nombre del repositorio"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "Status, in words",
            "fr": "État, en toutes lettres",
            "de": "Status in Worten",
            "es": "Estado, en palabras"
          }
        },
        {
          "key": "result",
          "type": "string",
          "label": {
            "en": "Last result (success, failure, error, killed…)",
            "fr": "Dernier résultat (success, failure, error, killed…)",
            "de": "Letztes Ergebnis (success, failure, error, killed…)",
            "es": "Último resultado (success, failure, error, killed…)"
          }
        },
